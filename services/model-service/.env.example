# Model Delivery Service — local dev environment variables
APP_NAME="NHAI Model Delivery Service"
APP_VERSION="1.0.0"
ENV=development
DEBUG=true

# Database (points to docker-compose postgres)
DATABASE_URL=postgresql+asyncpg://nhai:nhai_dev_password@localhost:5432/nhai_auth

# Auth Service Integration
AUTH_JWKS_URL=http://localhost:8001/auth/token/jwks

# AWS configuration (LocalStack)
AWS_REGION=ap-south-1
MODEL_BUCKET_NAME=nhai-models-local
S3_ENDPOINT_URL=http://localhost:4566
PRESIGNED_URL_EXPIRY_SECONDS=900

# Setup dummy AWS credentials for aioboto3/boto3 talking to LocalStack
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
