# Auth Service — local development environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME="NHAI Auth Service"
APP_VERSION="1.0.0"
ENV=development
DEBUG=true

# ── Database ─────────────────────────────────────────────────────────────────
# Points to the PostgreSQL container in docker-compose.yml
DATABASE_URL=postgresql+asyncpg://nhai:nhai_dev_password@localhost:5432/nhai_auth

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT RS256 Keypair ─────────────────────────────────────────────────────────
# Generate with:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# Then paste the single-line escaped PEM strings below.
JWT_RS256_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMII...\n-----END RSA PRIVATE KEY-----"
JWT_RS256_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMII...\n-----END PUBLIC KEY-----"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── AWS (disabled in dev) ─────────────────────────────────────────────────────
USE_AWS_SECRETS=false
AWS_REGION=ap-south-1
AWS_SECRET_NAME_RS256=nhai/rs256-keypair

# ── Internal Service API Key ──────────────────────────────────────────────────
# Shared secret between Auth Service and other microservices for internal calls
INTERNAL_API_KEY=dev-internal-key-change-in-prod

# ── Bootstrap Admin ───────────────────────────────────────────────────────────
BOOTSTRAP_ADMIN_EMAIL=admin@nhai.gov.in
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe@2026!
