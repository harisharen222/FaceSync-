# Attendance Sync Service — local development environment variables
APP_NAME="NHAI Attendance Sync Service"
APP_VERSION="1.0.0"
ENV=development
DEBUG=true

# Database (points to docker-compose postgres)
DATABASE_URL=postgresql+asyncpg://nhai:nhai_dev_password@localhost:5432/nhai_auth
SYNC_DATABASE_URL=postgresql://nhai:nhai_dev_password@localhost:5432/nhai_auth

# Auth Service Integration
AUTH_JWKS_URL=http://localhost:8001/auth/token/jwks
AUTH_SERVICE_URL=http://localhost:8001
INTERNAL_API_KEY=dev-internal-key-change-in-prod

# AWS configuration (points to LocalStack in docker-compose)
AWS_REGION=ap-south-1
# When running in docker network, LocalStack is accessible at http://localstack:4566
# When running locally via CLI, it's http://localhost:4566
SQS_QUEUE_URL=http://localhost:4566/000000000000/nhai-attendance-queue
EVENT_BUS_NAME=nhai-event-bus

# Setup dummy AWS credentials for aioboto3/boto3 talking to LocalStack
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
